# Credenciales privadas de Turso. No usar el prefijo NEXT_PUBLIC_.
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# Supabase Storage compatible con S3.
SUPABASE_BUCKET_URL=https://tu-proyecto.storage.supabase.co/storage/v1/s3
BUCKET_NAME=images
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY_ID=tu-access-key-id
BUCKET_SECRET_ACCESS_KEY=tu-secret-access-key

# Solo para crear o actualizar el administrador inicialmente.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=una-clave-de-12-caracteres

# URL pública del sitio, usada para SEO y sitemap.
SITE_URL=http://localhost:3000
